// Porchlight API Worker. Nothing here is deployed yet: every id is "TBD"
// until the owner approves creating the D1 database, KV namespace and queue.
// Secrets (set with `wrangler secret put`, never committed): APPLE_CLIENT_IDS,
// RESEND_API_KEY, AGGREGATOR_API_KEY, USPS_CLIENT_ID, USPS_CLIENT_SECRET,
// UPS_CLIENT_ID, UPS_CLIENT_SECRET, FEDEX_CLIENT_ID, FEDEX_CLIENT_SECRET,
// DHL_API_KEY, APNS_KEY_ID, APNS_PRIVATE_KEY. Local values go in .dev.vars.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "porchlight-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "observability": { "enabled": true },

  "vars": {
    "APNS_TEAM_ID": "VTQW687WBQ",
    "APP_ORIGIN": "https://porchlight.xanom.co",
    "APNS_TOPIC": "co.xanom.porchlight",
    // Host for "production" devices; "sandbox" devices use api.sandbox.push.apple.com.
    "APNS_HOST": "api.push.apple.com"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "porchlight",
      "database_id": "TBD",
      "migrations_dir": "migrations"
    }
  ],

  "kv_namespaces": [{ "binding": "RATE", "id": "TBD" }],

  "queues": {
    "producers": [{ "binding": "TRACK_QUEUE", "queue": "porchlight-track" }],
    "consumers": [
      {
        "queue": "porchlight-track",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },

  "triggers": { "crons": ["*/5 * * * *"] },

  // public/ is build output (README.md, "Serving"): site/ at the root, apps/web
  // under /app. /v1/* and the web app's routes run the Worker first; the Worker
  // answers app routes with /app/index.html when no file matches
  // (src/lib/assets.ts). Everything else, including /app/assets/*, is served
  // straight from public/, with the site's 404.html for misses.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/v1/*", "/app", "/app/*", "!/app/assets/*", "/signin", "/signin/*", "/auth/verify"]
  }
}
